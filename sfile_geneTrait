configfile: 'config.yml'

rule all:
    input:
        'data/gene_trait/summary.csv'

rule gene_trait:
    input:
        'data/iqtree_protein/{gene}.treefile',
        config['metadata']
    output:
        temp('data/gene_trait/{gene}-{trait}.csv')
    params:
        gene_col = config['gene_col']
    threads: 1
    conda:
        'ete3' #bin/env/ete3.yml
    script:
        'bin/scripts/gene_trait.py'

rule table_merge:
    input:
        expand('data/gene_trait/{gene}-{trait}.csv', gene=config['gene'],trait=config['trait_col'])
    output:
        'data/gene_trait/summary.csv'
    threads: 1
    conda:
        'ete3' #bin/env/ete3.yml
    script:
        'bin/scripts/gene_trait_merge.py'