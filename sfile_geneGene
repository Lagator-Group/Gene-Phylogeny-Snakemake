configfile: 'config.yml'

rule all:
    input:
        'data/gene_gene_summary.csv'

rule alisim:
    input:
        gene1_iqtree = 'data/iqtree_protein/{gene1}/{gene1}.iqtree',
        gene2_iqtree = 'data/iqtree_protein/{gene2}/{gene2}.iqtree',
        gene1_tree = 'data/iqtree_protein/{gene1}/{gene1}.treefile',
        gene2_tree = 'data/iqtree_protein/{gene2}/{gene2}.treefile'
    output:
        'data/alisim/{gene1}-{gene2}.csv'
    threads: 8
    params:
        num_bootstraps = config['num_bootstraps'],
        min_shared_leaves = config['min_shared_leaves'],
        random_seed = config['random_seed']
    conda:
        'bin/env/ete3.yml'
    script:
        'bin/scripts/alisim.py'

rule geneGene_merge:
    input:
        expand('data/alisim/{gene1}-{gene2}.csv', gene1=config['gene1'], gene2=config['gene2']),
    output:
        'data/gene_gene_summary.csv'
    threads: 1
    conda: 
        'bin/env/ete3.yml'
    script:
        'bin/scripts/gene_gene_merge.py'