configfile: 'config.yml'

rule all:
    input:
        expand('data/iqtree_protein/{gene}/{gene}.treefile',gene=config['genes']),

rule mkdir_iqtree:
    input:
    output:
        'data/iqtree_protein/{gene}/{gene}.log'
    threads: 1
    shell:
        'touch {output}'
    
rule iqtree_protein:
    input:
        'data/muscle_protein/{gene}.afa',
        'data/iqtree_protein/{gene}/{gene}.log'
    output:
        'data/iqtree_protein/{gene}/{gene}.treefile'
    params:
        prefix = 'data/iqtree_protein/{gene}/{gene}',
    threads: 16
    conda:
        'bin/env/iqtree.yml'
    shell:
        'iqtree -s {input[0]} -st AA -nt {threads} --prefix {params.prefix} -B 1000 -bnni'